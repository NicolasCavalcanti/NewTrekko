{
  "headers": [
    {
      "source": "/ads.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/trilhas", "destination": "/index.html" },
    { "source": "/sobre", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
