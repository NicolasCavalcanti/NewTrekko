# ============================================================
# TREKKO — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file to git.
# ============================================================

# --- Database --------------------------------------------------
# MySQL connection string (used by Drizzle ORM and mysql2 pool)
DATABASE_URL=mysql://user:password@host:3306/trekko

# DB-SEC-01: Field-level encryption key for PII columns.
# Must be exactly 64 hex characters (= 32 bytes = AES-256 key).
# Generate a new key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Losing this key means losing access to all encrypted guide data.
# Store securely (e.g. Railway/Render secret, AWS Secrets Manager).
DB_ENCRYPTION_KEY=

# --- Application -----------------------------------------------
NODE_ENV=development
PORT=3000

# --- Mercado Pago (payments) -----------------------------------
MERCADOPAGO_ACCESS_TOKEN=
VITE_MERCADOPAGO_PUBLIC_KEY=

# --- AWS S3 (image uploads) ------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# --- Authentication --------------------------------------------
# Owner openId — this user gets the admin role automatically
OWNER_OPEN_ID=
